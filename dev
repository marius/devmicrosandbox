#!/usr/bin/env ruby
# dev - manage the opencode microsandbox for this project
#
# Usage:
#   ./dev build     - docker build + load into microsandbox
#   ./dev create    - create the sandbox (volume, resources, secret)
#   ./dev remove    - remove the sandbox
#   ./dev exec      - drop into a shell inside the running sandbox
#   ./dev opencode  - run opencode inside the sandbox (args passed through)
#   ./dev backup    - take a git snapshot backup right now
#   ./dev gc        - garbage-collect old backups (time-tiered retention)
#   ./dev check-git - check the current repo against the latest snapshot

require 'json'
require 'open3'
require 'fileutils'
require 'time'
require 'digest'

AUTH_FILE = File.expand_path('~/.local/share/opencode/auth.json')
IMAGE = 'opencode-sandbox'
SANDBOX_NAME = 'opencode-dev'

BACKUP_DIR = "#{Dir.pwd}_backups"
GIT_MIRROR_DIR = File.join(BACKUP_DIR, 'git')
RESTIC_REPO = File.join(BACKUP_DIR, 'restic')
FINGERPRINT_FILE = File.join(BACKUP_DIR, 'last_fingerprint')
BACKUP_INTERVAL = 300 # seconds

GC_KEEP_LAST = ENV.fetch('GC_KEEP_LAST', '300').to_i
GC_KEEP_DAILY = ENV.fetch('GC_KEEP_DAILY', '14').to_i
GC_KEEP_WEEKLY = ENV.fetch('GC_KEEP_WEEKLY', '8').to_i
GC_KEEP_MONTHLY = ENV.fetch('GC_KEEP_MONTHLY', '6').to_i

def openrouter_key
  auth = JSON.parse(File.read(AUTH_FILE))
  auth.dig('openrouter', 'key') or abort "No openrouter.key found in #{AUTH_FILE}"
end

def cmd_build
  system('docker', 'build', '-t', IMAGE, '.') or abort 'docker build failed'

  statuses = Open3.pipeline(
    ['docker', 'save', IMAGE],
    %w[microsandbox load]
  )
  abort 'docker save | microsandbox load failed' unless statuses.all?(&:success?)
end

def cmd_create
  ENV['OPENROUTER_API_KEY'] = openrouter_key
  workspace = Dir.pwd

  created = system(
    'microsandbox', 'create', IMAGE,
    '--volume', "#{workspace}:/workspace",
    '--memory', '6G',
    '--cpus', '6',
    '--name', SANDBOX_NAME,
    '--workdir', '/workspace',
    '--secret', 'OPENROUTER_API_KEY@openrouter.ai'
  )
  abort 'microsandbox create failed' unless created
end

def cmd_remove
  removed = system("microsandbox remove --force #{SANDBOX_NAME}")
  abort 'microsandbox remove failed' unless removed
end

def cmd_backup_git
  workspace = Dir.pwd

  unless Dir.exist?(GIT_MIRROR_DIR)
    FileUtils.mkdir_p(GIT_MIRROR_DIR)
    puts 'Creating new git repository'
    system('git', 'init', '--bare', GIT_MIRROR_DIR) or abort 'git init --bare failed'
  end

  timestamp = Time.now.strftime('%Y%m%dT%H%M%S')
  refspec = "+refs/heads/*:refs/snapshots/#{timestamp}/*"

  Dir.chdir(GIT_MIRROR_DIR) do
    system('git', 'fetch', '--quiet', workspace, refspec) or warn 'git fetch failed'
  end
end

def cmd_backup_files
  workspace = Dir.pwd
  name = File.basename(workspace)

  unless Dir.exist?(RESTIC_REPO)
    FileUtils.mkdir_p(RESTIC_REPO)
    puts 'Creating new restic repository'
    system(
      'restic', '--insecure-no-password',
      'init', '-r', RESTIC_REPO) or abort 'restic init failed'
  end

  system(
    'restic', '-q', '--insecure-no-password', '-r', RESTIC_REPO, 'backup', workspace,
    '--tag', 'opencode-sandbox', '--tag', name
  ) or warn 'restic backup failed'
end

def cmd_backup
  cmd_backup_git
  cmd_backup_files
end

def workspace_fingerprint
  workspace = Dir.pwd
  files = Dir.glob(File.join(workspace, '**', '*'), File::FNM_DOTMATCH)
              .select { |f| File.file?(f) }
              .sort
  Digest::SHA256.hexdigest(
    files.map { |f| "#{f.sub(workspace + File::SEPARATOR, '')}:#{Digest::SHA256.file(f).hexdigest}" }.join("\n")
  )
end

def last_fingerprint
  return nil unless File.exist?(FINGERPRINT_FILE)
  File.read(FINGERPRINT_FILE).strip
end

def workspace_changed?
  last_fingerprint != workspace_fingerprint
end

def cmd_backup_if_changed(force: false)
  return unless force || workspace_changed?
  cmd_backup
  FileUtils.mkdir_p(BACKUP_DIR)
  File.write(FINGERPRINT_FILE, workspace_fingerprint)
end

def cmd_check_git
  unless Dir.exist?(GIT_MIRROR_DIR)
    warn "No git mirror found at #{GIT_MIRROR_DIR} - run a backup first"
    return
  end

  workspace = Dir.pwd

  Dir.chdir(GIT_MIRROR_DIR) do
    unless system('git', 'fsck', '--full', '--no-dangling', out: File::NULL, err: File::NULL)
      puts 'Git mirror repository is corrupt - run a backup to repair it'
      return
    end

    refs = `git for-each-ref --format='%(refname)' refs/snapshots/`.lines.map(&:strip)
    if refs.empty?
      warn 'No snapshots found yet'
      return
    end

    latest_timestamp = refs.map { |r| r.split('/')[2] }.max
    latest_refs = refs.select { |r| r.include?("refs/snapshots/#{latest_timestamp}/") }
    puts "Checking against snapshot #{latest_timestamp} (#{latest_refs.size} branches)"

    problems = []

    latest_refs.each do |ref|
      branch = ref.split('/').last
      old_sha = `git rev-parse #{ref}`.strip

      current_sha = Dir.chdir(workspace) { `git rev-parse --verify #{branch} 2>/dev/null`.strip }

      if current_sha.empty?
        problems << "branch '#{branch}' no longer exists in the workspace (was #{old_sha[0..7]})"
        next
      end

      Dir.chdir(workspace) do
        unless system('git', 'merge-base', '--is-ancestor', old_sha, current_sha)
          problems << "branch '#{branch}' history was rewritten - #{old_sha[0..7]} is no longer an ancestor of #{current_sha[0..7]}"
        end
      end
    end

    if problems.empty?
      puts 'Git backup OK'
    else
      puts 'Git backup PROBLEMS DETECTED:'
      problems.each { |p| puts "  - #{p}" }
    end
  end
end

def git_timestamps
  return [] unless Dir.exist?(GIT_MIRROR_DIR)
  Dir.chdir(GIT_MIRROR_DIR) do
    `git for-each-ref --format='%(refname)' refs/snapshots/`.lines
      .map { |l| l.split('/')[2] }
      .sort
      .uniq
      .reverse
  end
end

def retained_timestamps(timestamps, now = Time.now)
  return [] if timestamps.empty?
  retained = [timestamps.first] + timestamps.first(GC_KEEP_LAST)
  parsed = timestamps.map { |t| [t, Time.strptime(t, '%Y%m%dT%H%M%S')] }

  GC_KEEP_DAILY.times do |i|
    day = (now - i * 86400).strftime('%Y%m%d')
    newest = parsed.select { |_, tm| tm.strftime('%Y%m%d') == day }.map(&:first).max
    retained << newest if newest
  end

  GC_KEEP_WEEKLY.times do |i|
    week = (now - i * 7 * 86400).strftime('%G-W%V')
    newest = parsed.select { |_, tm| tm.strftime('%G-W%V') == week }.map(&:first).max
    retained << newest if newest
  end

  GC_KEEP_MONTHLY.times do |i|
    month = (now - i * 30 * 86400).strftime('%Y%m')
    newest = parsed.select { |_, tm| tm.strftime('%Y%m') == month }.map(&:first).max
    retained << newest if newest
  end

  retained.sort.uniq
end

def gc_git
  return unless Dir.exist?(GIT_MIRROR_DIR)
  timestamps = git_timestamps
  return if timestamps.empty?
  retained = retained_timestamps(timestamps)
  return if retained.empty?
  expired = timestamps - retained
  return if expired.empty?

  Dir.chdir(GIT_MIRROR_DIR) do
    expired.each do |ts|
      `git for-each-ref --format='%(refname)' refs/snapshots/#{ts}/`.lines.map(&:strip).each do |ref|
        system('git', 'update-ref', '-d', ref)
      end
    end
    system('git', 'gc', '--prune=now', '--quiet')
  end
  puts "git: pruned #{expired.size} snapshot group(s), kept #{retained.size}"
end

def gc_restic
  return unless Dir.exist?(RESTIC_REPO)
  system(
    'restic', '-q', '--insecure-no-password', '-r', RESTIC_REPO,
    'forget',
    '--keep-last', GC_KEEP_LAST.to_s,
    '--keep-daily', GC_KEEP_DAILY.to_s,
    '--keep-weekly', GC_KEEP_WEEKLY.to_s,
    '--keep-monthly', GC_KEEP_MONTHLY.to_s,
    '--prune'
  ) or warn 'restic forget failed'
end

def cmd_gc
  before = backup_size || 0
  gc_git
  gc_restic
  after = backup_size || 0
  puts "Backup garbage collection freed: #{human_size(before - after)}"
end

def backup_size
  return unless Dir.exist?(BACKUP_DIR)
  Dir.glob(File.join(BACKUP_DIR, '**', '*'), File::FNM_DOTMATCH)
          .select { |f| File.file?(f) }
          .sum { |f| File.size(f) }
end

def human_size(bytes)
  units = %w[B KB MB GB TB]
  power = 0
  power += 1 while bytes >= 1024**(power + 1) && power < units.size - 1
  '%g %s' % [bytes.to_f / (1024**power), units[power]]
end

def cmd_exec(args = nil)
  cmd_backup_if_changed(force: true)
  stop = false
  thread = Thread.new do
    loop do
      break if stop
      sleep BACKUP_INTERVAL
      break if stop

      begin
        cmd_backup_if_changed
      rescue StandardError => e
        warn "background backup failed: #{e.message}"
      end
    end
    puts 'creating one last backup, if there are changes'
    cmd_backup_if_changed
    cmd_check_git
    begin
      cmd_gc
    rescue StandardError => e
      warn "gc failed: #{e.message}"
    end
  end
  thread.abort_on_exception = false

  ENV['OPENROUTER_API_KEY'] = openrouter_key
  args = ARGV[1..] if args.nil?
  args = ['fish'] if args.empty?
  ok = system('microsandbox', 'exec', SANDBOX_NAME, '--', *args)

  stop = true
  thread.wakeup # interrupts sleep
  puts 'waiting for backup thread to finish'
  thread.join

  puts "Total backup size: #{human_size(backup_size)}"
  exit(ok ? 0 : 1)
end

def cmd_opencode
  cmd_exec(['opencode', *ARGV[1..]])
end

COMMANDS = {
  'build' => method(:cmd_build),
  'create' => method(:cmd_create),
  'remove' => method(:cmd_remove),
  'exec' => method(:cmd_exec),
  'opencode' => method(:cmd_opencode),
  'backup' => method(:cmd_backup),
  'gc' => method(:cmd_gc),
  'check-git' => method(:cmd_check_git)
}.freeze

handler = COMMANDS[ARGV[0]]

unless handler
  warn "Usage: #{File.basename($0)} <#{COMMANDS.keys.join('|')}>"
  exit 1
end

handler.call
